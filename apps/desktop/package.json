{
  "name": "@inventory/desktop",
  "productName": "轻松进销存",
  "version": "0.0.0",
  "private": true,
  "description": "轻松进销存 — 轻量级进销存出入库管理系统（离线优先桌面端）",
  "author": "轻松进销存",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main/index.js --external:electron --external:better-sqlite3 && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/preload/index.cjs --external:electron",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dist": "pnpm build && pnpm build:main && electron-builder --win portable --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@inventory/shared": "workspace:*",
    "element-plus": "^2.8.8",
    "exceljs": "^4.4.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.6.0"
  }
}
