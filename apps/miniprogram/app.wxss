/* 全局样式：仅放跨页面复用的少量工具类，组件样式交给 TDesign。 */
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.page-body {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.row-label {
  color: #888;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
}

.offline-banner {
  background: #fff3e0;
  color: #b26a00;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
}
