<view class="page-body">
  <t-toast id="t-toast" />

  <view wx:if="{{total > 0}}" class="muted total-tip">共 {{total}} 个客户</view>

  <view wx:for="{{items}}" wx:key="customerId" class="card">
    <view class="card-title">{{item.customerName}}</view>
    <view class="row">
      <text class="row-label">应收金额</text>
      <text>￥{{item.amountText}}</text>
    </view>
    <view class="row">
      <text class="row-label">已收</text>
      <text>￥{{item.receivedText}}</text>
    </view>
    <view class="row">
      <text class="row-label">未收</text>
      <text class="outstanding">￥{{item.outstandingText}}</text>
    </view>
    <view wx:if="{{item.dueText}}" class="row">
      <text class="row-label">到期日</text>
      <text>{{item.dueText}}</text>
    </view>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" text="加载中" />

  <block wx:if="{{!loading && items.length === 0}}">
    <t-empty wx:if="{{error}}" description="加载失败，请下拉重试" />
    <t-empty wx:else description="暂无应收数据" />
  </block>

  <view wx:if="{{finished && items.length > 0}}" class="empty">没有更多了</view>
</view>
