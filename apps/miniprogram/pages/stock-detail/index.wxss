.center {
  text-align: center;
}

.price {
  color: #d54941;
  font-weight: 600;
}

.bal-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.bal-main {
  flex: 1;
  min-width: 0;
}

.bal-name {
  font-weight: 500;
  margin-bottom: 4rpx;
}

.bal-qty {
  font-size: 34rpx;
  font-weight: 600;
  color: #0052d9;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}

.total-qty {
  font-size: 36rpx;
  font-weight: 700;
  color: #0052d9;
}

.total-avail {
  font-size: 28rpx;
}
