<view class="page-body">
  <t-toast id="t-toast" />

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" text="加载中" />

  <block wx:elif="{{error}}">
    <t-empty description="加载失败" />
    <view class="center">
      <t-button theme="primary" variant="outline" size="small" bind:tap="loadDetail">重新加载</t-button>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="card-title">{{product.name}}</view>
      <view class="row">
        <text class="row-label">商品编码</text>
        <text>{{product.code || '-'}}</text>
      </view>
      <view class="row">
        <text class="row-label">规格</text>
        <text>{{product.spec || '-'}}</text>
      </view>
      <view class="row">
        <text class="row-label">单位</text>
        <text>{{product.unit || '-'}}</text>
      </view>
      <view class="row">
        <text class="row-label">条码</text>
        <text>{{product.barcode || '-'}}</text>
      </view>
      <view class="row">
        <text class="row-label">售价</text>
        <text class="price">￥{{product.salePriceText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">各仓库存</view>
      <view wx:if="{{balances.length === 0}}" class="empty">暂无库存记录</view>
      <view wx:for="{{balances}}" wx:key="warehouseName" class="bal-row">
        <view class="bal-main">
          <view class="bal-name">{{item.warehouseName}}</view>
          <view class="muted">可用 {{item.availText}}</view>
        </view>
        <text class="bal-qty">{{item.qtyText}}</text>
      </view>

      <view wx:if="{{balances.length > 0}}" class="total-row">
        <text class="row-label">合计库存</text>
        <text class="total-qty">{{totalQtyText}}</text>
      </view>
      <view wx:if="{{balances.length > 0}}" class="total-row">
        <text class="row-label">合计可用</text>
        <text class="total-avail muted">{{totalAvailText}}</text>
      </view>
    </view>
  </block>
</view>
