.user-card {
  display: flex;
  align-items: center;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.env-warn {
