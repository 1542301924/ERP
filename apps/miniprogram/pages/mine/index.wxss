  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.group {
  margin-bottom: 24rpx;
}

.center {
  text-align: center;
  margin-top: 24rpx;
}
